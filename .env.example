# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# Public URL of this deployment. Passkeys are bound to its hostname, so a
# passkey made on video.winlab.tw does not work anywhere else.
AUTH_URL=https://video.winlab.tw
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# Comma-separated bootstrap admins. These emails are always admins and are
# added to the allow list on first sign-in; everyone else is managed in /admin.
ADMIN_EMAILS=admin@example.com

# Verification codes for setting or resetting a password (SMTP). Without
# SMTP_USER/SMTP_PASS the code is printed to the server log outside production,
# and refused in production.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
SMTP_USER=video@example.com
SMTP_PASS=app-password-here
# Optional. Defaults to "video.winlab.tw <SMTP_USER>"
# MAIL_FROM=video.winlab.tw <video@example.com>

# Nextcloud (WebDAV storage backend)
NEXTCLOUD_URL=https://nextcloud.example.com
NEXTCLOUD_USER=video-svc
NEXTCLOUD_APP_PASSWORD=app-password-here

# SQLite database file
DATABASE_PATH=./data/app.db

# Optional. Thumbnail cache directory (default: <DATABASE_PATH dir>/thumbs)
# THUMB_DIR=./data/thumbs

# Optional. Speech-to-text service (default: https://transcribe.winlab.tw)
# TRANSCRIBE_URL=https://transcribe.winlab.tw
